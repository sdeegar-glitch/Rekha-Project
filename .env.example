# Environment Variables Template
# Copy this file to .env and fill in your values

# Database (Supabase)
# NOTE: db.[PROJECT-REF].supabase.co resolves IPv6-only, which fails to
# connect on plenty of networks/hosts. DATABASE_URL MUST use the Supavisor
# pooler host below (it's IPv4-compatible) — the username MUST be
# "postgres.[PROJECT-REF]" (not plain "postgres"), or you'll hit
# "no tenant identifier provided".
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL is only used for migrations and stays on the direct (IPv6-only)
# host — if migrations fail to connect, you're on an IPv4-only network; run
# them from an environment with IPv6 egress, or connect via `prisma db execute`
# against DATABASE_URL instead for one-off SQL.
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-super-secret-key-change-in-production-min-32-chars-long"


# Google OAuth (optional)
GOOGLE_CLIENT_ID="your_google_client_id"
GOOGLE_CLIENT_SECRET="your_google_client_secret"

# Email (optional - for notifications)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
EMAIL_FROM="Rekha Patel Psychology <noreply@rekhapatel.com>"

# Razorpay (required — payment step will fail without these)
RAZORPAY_KEY_ID="rzp_test_..."
RAZORPAY_KEY_SECRET="..."
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_..."
RAZORPAY_WEBHOOK_SECRET="..."

# Socket.io
NEXT_PUBLIC_SOCKET_URL="http://localhost:3001"

# Redis (for Socket.io scaling)
REDIS_URL="redis://localhost:6379"

# Application
NODE_ENV="development"
NEXT_TELEMETRY_DISABLED=1

# Production Domain (for nginx)
DOMAIN="rekhapatel.com"