// Prisma Schema for Rekha Patel Psychology Practice
// Database: PostgreSQL

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

// Enums
enum UserRole {
  PATIENT
  ADMIN
  SUPER_ADMIN
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
  RESCHEDULED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum SlotStatus {
  AVAILABLE
  BOOKED
  BLOCKED
  MAINTENANCE
}

enum RecurrencePattern {
  NONE
  DAILY
  WEEKLY
  BIWEEKLY
  MONTHLY
}

enum NotificationType {
  APPOINTMENT_CREATED
  APPOINTMENT_CONFIRMED
  APPOINTMENT_REMINDER
  APPOINTMENT_CANCELLED
  APPOINTMENT_RESCHEDULED
  PAYMENT_SUCCEEDED
  PAYMENT_FAILED
  SLOT_AVAILABLE
  ADMIN_NOTE
}

// Models
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  passwordHash  String?
  image         String?
  role          UserRole  @default(PATIENT)
  phone         String?
  dateOfBirth   DateTime?
  address       String?
  emergencyContact Json?
  preferences   Json      @default("{}")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  appointments      Appointment[]      @relation("PatientAppointments")
  adminAppointments Appointment[]      @relation("AdminAppointments")
  availability      Availability[]
  payments          Payment[]
  notifications     Notification[]
  accounts          Account[]
  sessions          Session[]
  auditLogs         AuditLog[]

  @@index([email])
  @@index([role])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Service {
  id          String   @id @default(cuid())
  name        String
  description String   @db.Text
  duration    Int      // in minutes
  price       Decimal  @db.Decimal(10, 2)
  currency    String   @default("INR")
  color       String   @default("#3B82F6") // Hex color for UI
  icon        String?  // Lucide icon name
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  appointments Appointment[]
  timeSlots    TimeSlot[]
  availability Availability[] @relation("ServiceAvailability")

  @@index([isActive])
  @@index([sortOrder])
}

model Availability {
  id            String            @id @default(cuid())
  userId        String
  serviceId     String?
  dayOfWeek     Int?              // 0-6 (Sunday-Saturday), null for specific date
  specificDate  DateTime?         // For one-time availability
  startTime     String            // HH:mm format
  endTime       String            // HH:mm format
  slotDuration  Int               // in minutes
  bufferTime    Int      @default(0) // Buffer between appointments
  recurrence    RecurrencePattern @default(NONE)
  recurrenceEnd DateTime?
  isActive      Boolean  @default(true)
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  service  Service?  @relation("ServiceAvailability", fields: [serviceId], references: [id], onDelete: SetNull)
  timeSlots TimeSlot[]

  @@index([userId, dayOfWeek])
  @@index([userId, specificDate])
  @@index([isActive])
}

model TimeSlot {
  id            String     @id @default(cuid())
  availabilityId String
  serviceId     String?
  startTime     DateTime
  endTime       DateTime
  status        SlotStatus @default(AVAILABLE)
  isRecurring   Boolean    @default(false)
  parentSlotId  String?    // For recurring slots
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  // Relations
  availability Availability @relation(fields: [availabilityId], references: [id], onDelete: Cascade)
  service      Service?     @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  appointment  Appointment?
  parentSlot   TimeSlot?    @relation("RecurringSlots", fields: [parentSlotId], references: [id], onDelete: SetNull)
  childSlots   TimeSlot[]   @relation("RecurringSlots")

  @@unique([availabilityId, startTime])
  @@index([availabilityId])
  @@index([serviceId])
  @@index([startTime])
  @@index([status])
  @@index([parentSlotId])
}

model Appointment {
  id              String            @id @default(cuid())
  patientId       String
  adminId         String?
  serviceId       String
  timeSlotId      String            @unique
  status          AppointmentStatus @default(PENDING)
  reason          String?           @db.Text
  notes           String?           @db.Text // Patient notes
  adminNotes      String?           @db.Text // Private admin notes
  diagnosis       String?           @db.Text
  treatmentPlan   String?           @db.Text
  cancelledAt     DateTime?
  cancelledBy     String?
  cancellationReason String?
  reminderSent    Boolean  @default(false)
  reminderSentAt  DateTime?
  confirmedAt     DateTime?
  completedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  patient   User        @relation("PatientAppointments", fields: [patientId], references: [id], onDelete: Restrict)
  admin     User?       @relation("AdminAppointments", fields: [adminId], references: [id], onDelete: SetNull)
  service   Service     @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  timeSlot  TimeSlot    @relation(fields: [timeSlotId], references: [id], onDelete: Restrict)
  payment   Payment?

  @@index([patientId])
  @@index([adminId])
  @@index([serviceId])
  @@index([timeSlotId])
  @@index([status])
  @@index([createdAt])
  @@index([patientId, status])
}

model Payment {
  id              String        @id @default(cuid())
  appointmentId   String        @unique
  patientId       String
  amount          Decimal       @db.Decimal(10, 2)
  currency        String        @default("INR")
  status          PaymentStatus @default(PENDING)
  razorpayOrderId   String? @unique
  razorpayPaymentId String?
  razorpaySignature String?
  method          String?       // card, upi, netbanking, etc.
  metadata        Json?
  refundedAmount  Decimal       @default(0) @db.Decimal(10, 2)
  refundReason    String?
  failedReason    String?
  paidAt          DateTime?
  refundedAt      DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Relations
  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  patient     User        @relation(fields: [patientId], references: [id], onDelete: Restrict)

  @@index([patientId])
  @@index([status])
  @@index([razorpayOrderId])
  @@index([createdAt])
}

model Notification {
  id        String            @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String            @db.Text
  data      Json?
  read      Boolean   @default(false)
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([userId, createdAt])
  @@index([type])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String
  oldData   Json?
  newData   Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
}

model ClinicSettings {
  id                String   @id @default(cuid())
  clinicName        String   @default("Rekha Patel Psychology Clinic")
  clinicEmail       String
  clinicPhone       String
  clinicAddress     String   @db.Text
  timezone          String   @default("Asia/Kolkata")
  currency          String   @default("INR")
  defaultSlotDuration Int    @default(50)
  bufferTime        Int      @default(10)
  advanceBookingDays Int     @default(60)
  cancellationPolicy String  @db.Text
  reminderHours     Int      @default(24)
  allowOnlinePayment Boolean  @default(true)
  razorpayAccountId   String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}